{
  "schema_version": "1.0",
  "organization": "雄安新区市场服务部数据治理工作组",
  "roles": [
    {
      "id": "R-01",
      "name": "数据治理委员会",
      "position": "决策层",
      "responsibility": "审定数据战略、制度与年度计划，裁决跨部门数据争议，听取季度治理报告。"
    },
    {
      "id": "R-02",
      "name": "数据 Owner",
      "position": "业务管理层",
      "responsibility": "对业务数据的准确性、完整性和共享范围负最终责任，确认整改方案与验收结论。"
    },
    {
      "id": "R-03",
      "name": "数据 Steward",
      "position": "执行层",
      "responsibility": "维护数据标准、元数据、质量规则与资产台账，组织问题定位、整改跟踪和复检。"
    },
    {
      "id": "R-04",
      "name": "数据开发与平台组",
      "position": "技术支撑",
      "responsibility": "实现采集、清洗、脱敏、血缘解析与看板，保障任务稳定运行和变更可追溯。"
    },
    {
      "id": "R-05",
      "name": "安全合规岗",
      "position": "监督层",
      "responsibility": "审核分类分级、共享审批与个人信息保护措施，组织数据安全风险评估。"
    },
    {
      "id": "R-06",
      "name": "业务使用方",
      "position": "消费层",
      "responsibility": "按授权使用数据，反馈口径与质量问题，不得擅自复制、转供或对外披露。"
    }
  ],
  "raci": [
    {
      "process": "数据标准立项与发布",
      "R": "数据 Steward",
      "A": "数据治理委员会",
      "C": "数据 Owner、安全合规岗",
      "I": "数据开发与平台组"
    },
    {
      "process": "质量问题发现与工单派发",
      "R": "数据 Steward",
      "A": "数据 Owner",
      "C": "数据开发与平台组",
      "I": "业务使用方"
    },
    {
      "process": "问题整改与验收",
      "R": "源系统责任部门",
      "A": "数据 Owner",
      "C": "数据 Steward",
      "I": "数据治理委员会"
    },
    {
      "process": "分类分级与共享审批",
      "R": "数据 Steward",
      "A": "安全合规岗",
      "C": "数据 Owner",
      "I": "数据治理委员会"
    },
    {
      "process": "数据资产登记与变更",
      "R": "数据 Steward",
      "A": "数据 Owner",
      "C": "数据开发与平台组",
      "I": "业务使用方"
    },
    {
      "process": "血缘变更影响分析",
      "R": "数据开发与平台组",
      "A": "数据 Steward",
      "C": "数据 Owner",
      "I": "业务使用方"
    }
  ],
  "kpis": [
    {
      "name": "核心数据质量达标率",
      "target": "≥ 90%",
      "frequency": "月",
      "owner": "数据 Owner",
      "note": "首年目标；三年目标 95%"
    },
    {
      "name": "质量问题处置率",
      "target": "≥ 85%",
      "frequency": "月",
      "owner": "源系统责任部门",
      "note": "处置=修复+隔离+容差内观察；首年目标"
    },
    {
      "name": "数据资产登记完整率",
      "target": "100%",
      "frequency": "季",
      "owner": "数据 Steward"
    },
    {
      "name": "分类分级覆盖率",
      "target": "100%",
      "frequency": "季",
      "owner": "安全合规岗"
    },
    {
      "name": "共享接口脱敏覆盖率",
      "target": "100%",
      "frequency": "月",
      "owner": "数据开发与平台组"
    },
    {
      "name": "核心表字段级血缘覆盖率",
      "target": "100%",
      "frequency": "季",
      "owner": "数据开发与平台组"
    }
  ],
  "meetings": [
    {
      "name": "数据治理委员会会议",
      "frequency": "季度",
      "output": "治理报告、制度决议、资源协调"
    },
    {
      "name": "数据质量例会",
      "frequency": "月度",
      "output": "质量月报、整改台账、TOP 问题复盘"
    },
    {
      "name": "标准与模型评审",
      "frequency": "按需",
      "output": "标准评审意见、变更影响分析"
    }
  ]
}
